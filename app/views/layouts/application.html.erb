<!DOCTYPE html>
<html lang="en">
  <head>
    <title>NIT App</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>


    <!-- Include your application's CSS -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- External Libraries CSS (if using CDN) -->
    <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css", "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" %>
    <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/owl.carousel@2.3.4/dist/assets/owl.carousel.min.css" %>

    <!-- Custom Template CSS -->
    <%= stylesheet_link_tag "style", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %> <!-- For managing JS imports -->

  </head>

  <body>
    <!-- Topbar Start -->
<div class="container-fluid bg-dark py-2 d-none d-md-flex">
    <div class="container">
        <div class="d-flex justify-content-between topbar">
            <div class="top-info">
                <small class="me-3 text-white-50">
                    <%= link_to "#", class: "text-secondary" do %>
                        <i class="fas fa-map-marker-alt me-2"></i>23 Ranking Street, New York
                    <% end %>
                </small>
                <small class="me-3 text-white-50">
                    <%= link_to "#", class: "text-secondary" do %>
                        <i class="fas fa-envelope me-2"></i>Email@Example.com
                    <% end %>
                </small>
            </div>
            <div id="note" class="text-secondary d-none d-xl-flex"><small>Note : We help you to Grow your Business</small></div>
            <div class="top-link">
                <%= link_to "#", class: "bg-light nav-fill btn btn-sm-square rounded-circle" do %>
                    <i class="fab fa-facebook-f text-primary"></i>
                <% end %>
                <%= link_to "#", class: "bg-light nav-fill btn btn-sm-square rounded-circle" do %>
                    <i class="fab fa-twitter text-primary"></i>
                <% end %>
                <%= link_to "#", class: "bg-light nav-fill btn btn-sm-square rounded-circle" do %>
                    <i class="fab fa-instagram text-primary"></i>
                <% end %>
                <%= link_to "#", class: "bg-light nav-fill btn btn-sm-square rounded-circle me-0" do %>
                    <i class="fab fa-linkedin-in text-primary"></i>
                <% end %>
            </div>
        </div>
    </div>
</div>
<!-- Topbar End -->


       <!-- Navbar Start -->
<div class="container-fluid bg-primary">
    <div class="container">
        <nav class="navbar navbar-dark navbar-expand-lg py-0">
            <%= link_to root_path, class: "navbar-brand" do %>
                <h1 class="text-white fw-bold d-block">High<span class="text-secondary">Tech</span> </h1>
            <% end %>
            <button type="button" class="navbar-toggler me-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse bg-transparent" id="navbarCollapse">
                <div class="navbar-nav ms-auto mx-xl-auto p-0">
                    <%= link_to root_path, class: "nav-item nav-link active text-secondary" do %>
                        Home
                    <% end %>
                    <%= link_to about_path, class: "nav-item nav-link" do %>
                        About
                    <% end %>
                    <%= link_to service_path, class: "nav-item nav-link" do %>
                        Services
                    <% end %>
                    <%= link_to projects_path, class: "nav-item nav-link" do %>
                        Projects
                    <% end %>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Pages</a>
                        <div class="dropdown-menu rounded">
                            <%= link_to blog_path, class: "dropdown-item" do %>
                                Our Blog
                            <% end %>
                            <%= link_to team_path, class: "dropdown-item" do %>
                                Our Team
                            <% end %>
                            <%= link_to testimonial_path, class: "dropdown-item" do %>
                                Testimonial
                            <% end %>
                            <%= link_to custom_404_path, class: "dropdown-item" do %>
                                404 Page
                                <% end %>

                        </div>
                    </div>
                    <%= link_to contact_path, class: "nav-item nav-link" do %>
                        Contact
                    <% end %>
                </div>
            </div>
            <div class="d-none d-xl-flex flex-shirink-0">
                <div id="phone-tada" class="d-flex align-items-center justify-content-center me-4">
                    <a href="#" class="position-relative animated tada infinite">
                        <i class="fa fa-phone-alt text-white fa-2x"></i>
                        <div class="position-absolute" style="top: -7px; left: 20px;">
                            <span><i class="fa fa-comment-dots text-secondary"></i></span>
                        </div>
                    </a>
                </div>
                <div class="d-flex flex-column pe-4 border-end">
                    <span class="text-white-50">Have any questions?</span>
                    <span class="text-secondary">Call: + 0123 456 7890</span>
                </div>
                <div class="d-flex align-items-center justify-content-center ms-4 ">
                    <a href="#"><i class="bi bi-search text-white fa-2x"></i> </a>
                </div>
            </div>
        </nav>
    </div>
</div>
<!-- Navbar End -->

    <%= yield %>



        <!-- Footer Start -->
<div class="container-fluid footer bg-dark wow fadeIn" data-wow-delay=".3s">
  <div class="container pt-5 pb-4">
    <div class="row g-5">
      
      <!-- Logo and About -->
      <div class="col-lg-3 col-md-6">
        <%= link_to root_path do %>
          <h1 class="text-white fw-bold d-block">High<span class="text-secondary">Tech</span></h1>
        <% end %>
        <p class="mt-4 text-light">Lorem ipsum dolor sit amet consectetur adipisicing elit. Soluta facere delectus qui placeat inventore consectetur repellendus optio debitis.</p>
        <div class="d-flex hightech-link">
          <%= link_to "#", class: "btn-light nav-fill btn btn-square rounded-circle me-2" do %>
            <i class="fab fa-facebook-f text-primary"></i>
          <% end %>
          <%= link_to "#", class: "btn-light nav-fill btn btn-square rounded-circle me-2" do %>
            <i class="fab fa-twitter text-primary"></i>
          <% end %>
          <%= link_to "#", class: "btn-light nav-fill btn btn-square rounded-circle me-2" do %>
            <i class="fab fa-instagram text-primary"></i>
          <% end %>
          <%= link_to "#", class: "btn-light nav-fill btn btn-square rounded-circle me-0" do %>
            <i class="fab fa-linkedin-in text-primary"></i>
          <% end %>
        </div>
      </div>

      <!-- Short Links -->
      <div class="col-lg-3 col-md-6">
        <%= link_to "#", class: "h3 text-secondary" do %>Short Link<% end %>
        <div class="mt-4 d-flex flex-column short-link">
          <%= link_to about_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>About Us
          <% end %>
          <%= link_to contact_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Contact Us
          <% end %>
          <%= link_to service_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Our Services
          <% end %>
          <%= link_to projects_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Our Projects
          <% end %>
          <%= link_to blog_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Latest Blog
          <% end %>
        </div>
      </div>

      <!-- Help Links -->
      <div class="col-lg-3 col-md-6">
        <%= link_to about_path, class: "h3 text-secondary" do %>Help Link<% end %>
        <div class="mt-4 d-flex flex-column help-link">
          <%= link_to about_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Terms Of Use
          <% end %>
          <%= link_to about_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Privacy Policy
          <% end %>
          <%= link_to about_path class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Helps
          <% end %>
          <%= link_to about_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>FAQs
          <% end %>
          <%= link_to contact_path, class: "mb-2 text-white" do %>
            <i class="fas fa-angle-right text-secondary me-2"></i>Contact
          <% end %>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="col-lg-3 col-md-6">
        <%= link_to "#", class: "h3 text-secondary" do %>Contact Us<% end %>
        <div class="text-white mt-4 d-flex flex-column contact-link">
          <%= link_to "#", class: "pb-3 text-light border-bottom border-primary" do %>
            <i class="fas fa-map-marker-alt text-secondary me-2"></i>123 Street, New York, USA
          <% end %>
          <%= link_to "tel:+1234567890", class: "py-3 text-light border-bottom border-primary" do %>
            <i class="fas fa-phone-alt text-secondary me-2"></i>+123 456 7890
          <% end %>
          <%= mail_to "info@example.com", "info@example.com", class: "py-3 text-light border-bottom border-primary" do %>
            <i class="fas fa-envelope text-secondary me-2"></i>
          <% end %>
        </div>
      </div>

    </div>

    <hr class="text-light mt-5 mb-4">

    <!-- Footer Bottom -->
    <div class="row">
      <div class="col-md-6 text-center text-md-start">
        <span class="text-light">
          <%= link_to root_path, class: "text-secondary" do %>
            <i class="fas fa-copyright text-secondary me-2"></i>
            Your Site Name
          <% end %>, All rights reserved.
        </span>
      </div>
      <div class="col-md-6 text-center text-md-end">
        <span class="text-light">
          Designed By <%= link_to "HTML Codex", "https://htmlcodex.com", class: "text-secondary", target: "_blank" %> 
          Distributed By <%= link_to "ThemeWagon", "https://themewagon.com", target: "_blank" %>
        </span>
      </div>
    </div>

  </div>
</div>
<!-- Footer End -->


    <!-- Back to Top -->
    <a href="#" class="btn btn-secondary btn-square rounded-circle back-to-top">
      <i class="fa fa-arrow-up text-white"></i>
    </a>

    <!-- JavaScript Libraries (Include from CDN or assets) -->
    <%= javascript_include_tag "https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js" %>
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js" %>

    <!-- Your Custom JavaScript (Main JS file) -->
    <%= javascript_include_tag "main", "data-turbo-track": "reload" %>


<!-- JS (before </body>) -->
<%= javascript_include_tag "https://code.jquery.com/jquery-3.6.0.min.js" %>
<%= javascript_include_tag "https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" %>

  </body>
</html>
