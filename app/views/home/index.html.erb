      <h1>Services Built Specifically For Your Business</h1>
    </div>

    <div class="row g-5 services-inner">
      <% services = [
        { icon: "fa-code", title: "Web Design", description: "Lorem ipsum dolor sit amet elit. Sed efficitur quis purus ut interdum. Aliquam dolor eget urna ultricies tincidunt." },
        { icon: "fa-file-code", title: "Web Development", description: "Lorem ipsum dolor sit amet elit. Sed efficitur quis purus ut interdum. Aliquam dolor eget urna ultricies tincidunt." },
        { icon: "fa-external-link-alt", title: "UI/UX Design", description: "Lorem ipsum dolor sit amet elit. Sed efficitur quis purus ut interdum. Aliquam dolor eget urna ultricies tincidunt." },
        { icon: "fas fa-user-secret", title: "Web Security", description: "Lorem ipsum dolor sit amet elit. Sed efficitur quis purus ut interdum. Aliquam dolor eget urna ultricies tincidunt." },
        { icon: "fa-envelope-open", title: "Digital Marketing", description: "Lorem ipsum dolor sit amet elit. Sed efficitur quis purus ut interdum. Aliquam dolor eget urna ultricies tincidunt." },
        { icon: "fas fa-laptop", title: "Programming", description: "Lorem ipsum dolor sit amet elit. Sed efficitur quis purus ut interdum. Aliquam dolor eget urna ultricies tincidunt." }
      ] %>

      <% services.each_with_index do |service, index| %>
        <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="<%= 0.3 + (index % 3) * 0.2 %>s">
          <div class="services-item bg-light">
            <div class="p-4 text-center services-content">
              <div class="services-content-icon">
                <i class="fa <%= service[:icon] %> fa-7x mb-4 text-primary"></i>
                <h4 class="mb-3"><%= service[:title] %></h4>
                <p class="mb-4"><%= service[:description] %></p>
                <%= link_to "Read More", "#", class: "btn btn-secondary text-white px-5 py-3 rounded-pill" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
<!-- Services End -->

<!-- Project Start -->
